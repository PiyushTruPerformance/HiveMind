# ---------------------------------------------------------------------------
# HiveX Platform — frontend environment
# ---------------------------------------------------------------------------
# Every value below is OPTIONAL for the demo. With no .env.local at all the app
# boots in DEMO IDENTITY mode (Clerk is not mounted) and every screen works.
# ---------------------------------------------------------------------------

# Clerk — set BOTH to switch the app from demo identity to real authentication.
# Matches the Reporting OS convention (SYSTEM_ARCHITECTURE §9.1).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---------------------------------------------------------------------------
# Tru Reporting backends — same names as the Tru Reporting client
# ---------------------------------------------------------------------------
# Ask Tru switches from the local demo to the live service when the Clerk keys
# above AND both URLs below are set. No trailing slash.
#
# Core API, including /api/v1. Resolves the signed-in user (GET /users/me) and
# their workspaces (GET /workspaces/) from the Clerk session.
NEXT_PUBLIC_BASE_URL=
# AI service, including /api/ai/v1. Every Ask Tru call uses it:
# {base}/universal-chat/..., {base}/connectors/... and the WebSocket
# (https → wss, same host and prefix).
NEXT_PUBLIC_AI_BACKEND_URL=
# Optional. Direct AI service URL (with /api/ai/v1) for the chat WebSocket.
# Set it when NEXT_PUBLIC_AI_BACKEND_URL is a proxy path such as /external-api —
# Vercel rewrites do not forward WebSockets. Falls back to the URL above.
NEXT_PUBLIC_AI_WS_URL=
# Optional. Target of the /external-api proxy (next.config.mjs), with /api/ai/v1.
# Use with NEXT_PUBLIC_AI_BACKEND_URL=/external-api to avoid CORS in deployments.
AI_BACKEND_PROXY_URL=

# ---------------------------------------------------------------------------
# Integrations API (server-only — never prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# HiveX's /api/integrations/* route handlers talk to the shared database,
# Google and Nango directly. Names match the Tru Reporting backend's settings.

# Public origin of this HiveX deployment. Google redirects to
# {APP_URL}/api/integrations/google/callback — register that exact URI on the
# Google OAuth client (alongside Reporting's own callback).
APP_URL=http://localhost:3005

# Shared Supabase project (service role: the API enforces tenant ownership itself).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# MUST be the same Fernet key as the Tru Reporting backend, or neither app can
# read OAuth tokens the other stored.
ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

NANGO_SECRET_KEY=
NANGO_BASE_URL=https://api.nango.dev
NANGO_CONNECT_BASE_URL=https://connect.nango.dev
# Optional per-provider Nango integration ids (default to the provider key):
# NANGO_SLACK_INTEGRATION_ID=slack
# NANGO_OUTLOOK_INTEGRATION_ID=outlook
# NANGO_ZOOM_INTEGRATION_ID=zoom

# FastAPI core server. When set, /api/v1/* is proxied to it (next.config.mjs).
# Leave blank to keep the mock service layer in charge.
NEXT_PUBLIC_FAST_API=

# Nango public key — used later by the real integration Connect UI.
NEXT_PUBLIC_NANGO_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# HR OS service (services/hr-os) — the CV Analyzer API.
# HR OS recruitment screens call this for real; they are not mocked. Defaults
# to http://localhost:8000 when unset.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_HR_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# TEMPORARY: embedded Tru Reporting OS
# ---------------------------------------------------------------------------
# When set, Reporting OS product pages show this deployed app in an iframe
# instead of the native HiveX Reporting OS. Unset to restore the native pages.
NEXT_PUBLIC_REPORTING_OS_URL=https://tru-reporting-dev-application.vercel.app
