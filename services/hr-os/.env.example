DATABASE_URL=sqlite:///./cv_analyzer.db
# To use Supabase Postgres instead, requires "psycopg[binary]" (already in requirements.txt):
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
#
# Use the POOLER connection string on port 5432 ("Session pooler" — Database settings ->
# Connection string -> "Session pooler" tab), NOT "Direct connection" and NOT "Transaction
# pooler" (port 6543):
#   - Direct connection's hostname is IPv6-only and won't resolve on most home/ISP networks
#     (confirmed via nslookup: it returns only an AAAA record, no A record).
#   - Transaction pooler (port 6543) doesn't keep a stable backend connection per session,
#     which breaks SQLAlchemy's transaction handling — confirmed in practice as intermittent
#     `psycopg.errors.InFailedSqlTransaction` 500s on unrelated later requests, once a single
#     query failed anywhere. Session pooler (port 5432, same hostname) avoids this.
#
# If your password has special characters (?, !, ,, @, etc.), URL-encode it — e.g. Python's
# urllib.parse.quote(password, safe="").

BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# onboarding@resend.dev works without domain verification, for testing only — verify a real domain for production
COMPANY_NAME=the hiring team
# Used in the candidate-facing status email sign-off, e.g. "Acme Inc." or "The Acme Recruiting Team"

CLERK_SECRET_KEY=
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# Must include the HiveX platform origin (hivex/ runs on :3005).
CORS_ALLOW_ORIGINS=["http://localhost:3005","http://localhost:5173"]

# Path to the Tesseract OCR binary (winget install UB-Mannheim.TesseractOCR on Windows)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Primary provider is "openai" (gpt-4o-mini, paid). If it fails — quota, rate limit,
# outage — requests automatically fall back to Gemini instead of failing outright,
# as long as GEMINI_API_KEY is also set. Flip AI_PROVIDER to "gemini" to make Gemini
# the primary and OpenAI the fallback instead.
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# Gate item #3 (auto-rejection policy) — still unanswered by the manager, default false.
AUTO_REJECT_ENABLED=false
