# ==========================================
# Hive Mind - Monorepo .gitignore
# ==========================================

# --- Node / JavaScript / TypeScript (hivex) ---
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# Next.js / Build Outputs
.next/
out/
build/
dist/
.turbo/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# --- Python / Backend Services (services/hr-os) ---
# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Testing / Pytest / Type Checking
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Databases & Local Storage
*.db
*.sqlite
*.sqlite3
instance/

# --- Environment & Secret Management ---
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
.clerk/

# Do not ignore example / template env files
!.env.example
!.env.*.example

# --- Logs & Debugging ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# --- Vercel & Deployment ---
.vercel

# --- OS & System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- IDE & Editor Configs ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Tooling & Agent / Local Assistant ---
.claude/launch.json
